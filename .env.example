# =========================================================
#  Sao chép file này thành ".env" rồi điền giá trị thật.
#  Lệnh: cp .env.example .env
# =========================================================

# ----- Kết nối cơ sở dữ liệu MySQL -----
# Database duy nhất cho toàn bộ project (Node.js backend + PHP admin panel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=website_vnpt
# Số kết nối tối đa trong pool (Node.js)
DB_CONNECTION_LIMIT=10

# ----- Bảo mật đăng nhập (JWT) -----
# Chuỗi bí mật ký token — ĐỔI thành chuỗi ngẫu nhiên dài khi chạy thật.
JWT_SECRET=doi_chuoi_bi_mat_nay_thanh_ngau_nhien_that_dai
# Thời hạn token (vd: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# ----- Chatbot AI (Google Gemini) — tùy chọn -----
# Lấy Gemini API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ----- Cổng chạy server Node.js -----
PORT=3000

# =========================================================
#  HƯỚNG DẪN SETUP NHANH
# =========================================================
#
#  1. Import database:
#     mysql -u root -p < database/website_vnpt.sql
#
#  2. Cài dependencies Node.js:
#     npm install
#
#  3. Chạy server Node.js (backend + frontend):
#     npm start          (production)
#     npm run dev        (development, auto-reload)
#
#  4. Truy cập website:
#     http://localhost:3000
#
#  5. Truy cập PHP Admin Panel (cần PHP + Apache/Nginx):
#     http://localhost/website_vnpt/admin_panel/
#     Hoặc dùng XAMPP: đặt thư mục vào htdocs/
#
# =========================================================
#  TÀI KHOẢN DEMO
# =========================================================
#
#  Node.js Backend (JWT):
#    Email: admin@vnpt.vn | Mật khẩu: admin123
